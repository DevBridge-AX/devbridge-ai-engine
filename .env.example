# =============================================================================
# DevBridge AI Engine - 환경변수
# 실제 값은 .env 파일에 작성하고 git에 커밋하지 않습니다.
# =============================================================================

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO

# --- Internal API 인증 (Spring -> FastAPI) ---
# 모든 요청의 X-Internal-Api-Key 헤더 값과 비교됩니다. 불일치 시 401.
INTERNAL_API_KEY=changeme

# --- Database (AI 도메인 전용 MySQL 스키마, Spring과 별도 DB 계정 사용) ---
# 이 레포는 KNOWLEDGE_DOCUMENTS, DATA_SOURCES, DATABASE_SCHEMAS, GIT_COMMITS,
# document_chunks, usage_logs 테이블만 소유합니다. USERS/WORKSPACES 등 Spring 소유
# 테이블에는 접근하지 않으므로 별도 스키마/계정을 사용해야 합니다.
MYSQL_USER_AI=your_username
MYSQL_PASSWORD_AI=your_password
DATABASE_URL=mysql+pymysql://${MYSQL_USER_AI}:${MYSQL_PASSWORD_AI}@devbridge-mysql:3306/devbridge

# --- Vector store (임베디드/파일 기반, 별도 서버 없음) ---
# 온디바이스 전환 시 이 경로(디렉토리)를 그대로 이동하는 것만으로 동작해야 합니다.
VECTOR_STORE_PROVIDER=chroma
VECTOR_STORE_PATH=./data/vector_store

# --- GMS 통합 API Key (Claude / GPT / Gemini 공통) ---
GMS_API_KEY=

# --- GMS Provider Base URLs ---
# provider.py가 모델명 prefix로 provider를 자동 감지하여 아래 URL 중 하나를 사용합니다.
# claude-* → ANTHROPIC_BASE_URL, gpt-*/o* → OPENAI_BASE_URL, gemini-* → GEMINI_BASE_URL
ANTHROPIC_BASE_URL=https://gms.ssafy.io/gmsapi/api.anthropic.com
OPENAI_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
GEMINI_BASE_URL=https://gms.ssafy.io/gmsapi/generativelanguage.googleapis.com/v1beta

# --- Embeddings (Gemini Embedding via GMS, GEMINI_BASE_URL/models 사용) ---
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_MODEL_VERSION=v1

# --- LLM 모델 설정 ---
# 모델 교체/비용 튜닝은 이 값들만 변경 (provider.py 코드 변경 불필요)
MAIN_MODEL=claude-sonnet-4-6
REWRITE_MODEL=claude-sonnet-4-6          # 멀티턴 쿼리 재구성 (경량, OpenAI)
GROUNDING_MODEL=gemini-3.5-flash-lite  # 그라운딩 이진 판정 전용 (경량, Gemini)

# --- Document Analysis ---
# fallback: 모델 API 호출 없이 규칙 기반 분석
# llm: provider.py의 GMS LLM 호출 구조 사용
AI_ANALYSIS_MODE=fallback
DOCUMENT_ANALYSIS_MODEL=fallback-v1

# --- 기타 ---
MAX_CONTEXT_TOKENS=30000
GROUNDING_SIMILARITY_THRESHOLD=0.35  # 코사인 유사도 1차 필터 임계치

# --- Spring backend 연동 ---
# Git 인덱싱 시 author_id 매핑 등에 사용하는 사용자 조회 API
SPRING_BACKEND_BASE_URL=http://localhost:8080
SPRING_USER_LOOKUP_PATH=/internal/users/lookup
